<odoo>
    <record id="view_picking_form_alimac_pallet" model="ir.ui.view">
        <field name="name">stock.picking.form.alimac.pallet</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_alimac_view_material_moves"
                        type="object" icon="fa-recycle"
                        invisible="alimac_material_move_count == 0">
                    <field name="alimac_material_move_count" widget="statinfo"
                           string="Materiali imballo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
