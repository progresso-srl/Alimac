<odoo>
    <record id="view_picking_type_form_alimac_pallet" model="ir.ui.view">
        <field name="name">stock.picking.type.form.alimac.pallet</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='second']" position="inside">
                <group string="Imballo pallet (Alimac)" name="alimac_pallet_packing"
                       invisible="code != 'internal'">
                    <field name="alimac_auto_validate"/>
                    <field name="alimac_is_pallet_packing"/>
                    <field name="alimac_material_location_id"
                           invisible="not alimac_is_pallet_packing"
                           options="{'no_create': True}"/>
                    <field name="alimac_consumption_location_id"
                           invisible="not alimac_is_pallet_packing"
                           options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
