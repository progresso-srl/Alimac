<odoo>
    <record id="alimac_pallet_packing_wizard_form" model="ir.ui.view">
        <field name="name">alimac.pallet.packing.wizard.form</field>
        <field name="model">alimac.pallet.packing.wizard</field>
        <field name="arch" type="xml">
            <form string="Imballa">
                <field name="company_id" invisible="1"/>
                <field name="move_id" invisible="1"/>
                <field name="allowed_packaging_uom_ids" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="picking_id">
                    Nessun imballo collegato alla rotta: verrà creato un nuovo trasferimento di imballo
                    con i soli colli completi. I sacchi restanti rimangono in ubicazione.
                </div>
                <group>
                    <group string="Produzione">
                        <field name="production_id"/>
                        <field name="product_id"/>
                        <field name="picking_id" invisible="not picking_id"/>
                        <field name="picking_type_id" readonly="picking_id" required="1"
                               options="{'no_create': True}"/>
                        <field name="source_location_id"/>
                    </group>
                    <group string="Colli">
                        <field name="packaging_uom_id" required="1" options="{'no_create': True}"/>
                        <field name="package_type_id" required="1" options="{'no_create': True}"/>
                        <label for="qty_per_package"/>
                        <div class="o_row">
                            <field name="qty_per_package"/>
                            <field name="content_uom_id" readonly="1"/>
                        </div>
                        <label for="qty_available"/>
                        <div class="o_row">
                            <field name="qty_available"/>
                            <field name="content_uom_id" readonly="1"/>
                        </div>
                        <label for="qty_to_pack"/>
                        <div class="o_row">
                            <field name="qty_to_pack"/>
                            <field name="content_uom_id" readonly="1"/>
                        </div>
                        <field name="package_count"/>
                        <label for="last_package_qty"/>
                        <div class="o_row">
                            <field name="last_package_qty"/>
                            <field name="content_uom_id" readonly="1"/>
                        </div>
                    </group>
                </group>
                <separator string="Materiali di imballo da scaricare"/>
                <field name="material_line_ids">
                    <list editable="bottom">
                        <field name="product_id"/>
                        <field name="quantity"/>
                        <field name="product_uom_id"/>
                    </list>
                </field>
                <footer>
                    <button name="action_pack" type="object" string="Imballa" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Annulla" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
