<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add is_transport to product.template form (field lives on template) -->
    <record id="product_template_form_view_inherit_transport" model="ir.ui.view">
        <field name="name">product.template.form.inherit.transport</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_ok']" position="after">
                <field name="is_transport" string="Is Transport Product"/>
            </xpath>
        </field>
    </record>
</odoo>
