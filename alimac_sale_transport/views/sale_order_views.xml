<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order Form View: buttons + transport indicator + line columns -->
    <record id="sale_order_form_view_inherit_transport" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.transport</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Buttons in header -->
            <xpath expr="//button[@name='action_quotation_send']" position="after">
                <button name="action_incorporate_transport"
                        string="Incorporate Transport"
                        type="object"
                        class="btn-primary"
                        invisible="transport_incorporated or invoice_count &gt; 0"
                        help="Distribute transport costs proportionally across product lines"/>
                <button name="action_uncorporate_transport"
                        string="Uncorporate Transport"
                        type="object"
                        class="btn-secondary"
                        invisible="not transport_incorporated or invoice_count &gt; 0"
                        help="Restore original prices and transport line"/>
            </xpath>

            <!-- Hidden field for conditionals -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="transport_incorporated" invisible="1"/>
            </xpath>

            <!-- Alert banner when incorporated -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info" role="alert"
                     invisible="not transport_incorporated">
                    <strong>Transport Incorporated:</strong>
                    Order lines are locked. Use "Uncorporate Transport" to modify them.
                </div>
            </xpath>

            <!-- Extra columns on order_line list (Odoo 19 uses <list> not <tree>) -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="material_price_unit"
                       string="Material Price"
                       optional="hide"
                       readonly="1"/>
                <field name="transport_price_unit"
                       string="Transport Quota"
                       optional="hide"
                       readonly="1"/>
                <field name="material_amount"
                       string="Material Amount"
                       optional="hide"
                       readonly="1"
                       widget="monetary"/>
                <field name="transport_amount"
                       string="Transport Amount"
                       optional="hide"
                       readonly="1"
                       widget="monetary"/>
            </xpath>

            <!-- Transport reference amount column -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']" position="after">
                <field name="transport_reference_amount"
                       string="Transport Ref."
                       optional="hide"
                       readonly="1"
                       widget="monetary"/>
            </xpath>

            <!-- Grey-out incorporated transport lines -->
            <xpath expr="//field[@name='order_line']/list" position="attributes">
                <attribute name="decoration-muted">product_id.is_transport and transport_reference_amount &gt; 0 and price_unit == 0</attribute>
            </xpath>
        </field>
    </record>

    <!-- Sale Order List View: add transport indicator -->
    <record id="sale_order_list_view_inherit_transport" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.transport</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="transport_incorporated" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
