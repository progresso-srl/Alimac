#. module: alimac_sale_transport
#: model_terms:ir.ui.view,arch_db:alimac_sale_transport.sale_order_form_view_inherit_transport
msgid "<strong>Transport Incorporated:</strong> Order lines are locked. Use \"Uncorporate Transport\" to modify them."
msgstr "<strong>Trasporto incorporato:</strong> le righe d'ordine sono bloccate. Usare \"Scorpora trasporto\" per modificarle."

#. module: alimac_sale_transport
#. odoo-python
#: code:addons/alimac_sale_transport/models/sale_order_line.py:0
msgid "Cannot add new product lines when transport is incorporated. Please use \"Uncorporate Transport\" button first."
msgstr "Impossibile aggiungere righe prodotto con il trasporto incorporato. Usare prima il pulsante \"Scorpora trasporto\"."

#. module: alimac_sale_transport
#. odoo-python
#: code:addons/alimac_sale_transport/models/sale_order.py:0
msgid "Cannot change the shipping method when transport is incorporated. Please use \"Uncorporate Transport\" button first."
msgstr "Impossibile modificare la spedizione con il trasporto incorporato. Usare prima il pulsante \"Scorpora trasporto\"."

#. module: alimac_sale_transport
#. odoo-python
#: code:addons/alimac_sale_transport/models/sale_order_line.py:0
msgid "Cannot delete order lines when transport is incorporated. Please use \"Uncorporate Transport\" button first."
msgstr "Impossibile eliminare righe d'ordine con il trasporto incorporato. Usare prima il pulsante \"Scorpora trasporto\"."

#. module: alimac_sale_transport
#. odoo-python
#: code:addons/alimac_sale_transport/models/sale_order_line.py:0
msgid "Cannot delete order lines: transport is incorporated and the order has already been invoiced."
msgstr "Impossibile eliminare righe: il trasporto è incorporato e l'ordine è già stato fatturato."

#. module: alimac_sale_transport
#. odoo-python
#: code:addons/alimac_sale_transport/models/sale_order_line.py:0
msgid "Cannot delete the transport/shipping line while transport is incorporated. Please use \"Uncorporate Transport\" button first."
msgstr "Impossibile eliminare la riga trasporto/spedizione con il trasporto incorporato. Usare prima il pulsante \"Scorpora trasporto\"."

#. module: alimac_sale_transport
#. odoo-python
#: code:addons/alimac_sale_transport/models/sale_order.py:0
msgid "Cannot incorporate transport: no product lines with convertible tonnage found."
msgstr "Impossibile incorporare il trasporto: nessuna riga prodotto convertibile in tonnellate."

#. module: alimac_sale_transport
#. odoo-python
#: code:addons/alimac_sale_transport/models/sale_order.py:0
#, python-format
msgid "Cannot incorporate transport: product line \"%s\" has different taxes than transport line."
msgstr "Impossibile incorporare il trasporto: la riga prodotto \"%s\" ha imposte diverse dalla riga trasporto."

#. module: alimac_sale_transport
#. odoo-python
#: code:addons/alimac_sale_transport/models/sale_order.py:0
msgid "Cannot incorporate transport: this order has draft invoices. Delete or cancel them first."
msgstr "Impossibile incorporare il trasporto: l'ordine ha fatture in bozza. Eliminarle o annullarle prima."

#. module: alimac_sale_transport
#. odoo-python
#: code:addons/alimac_sale_transport/models/sale_order.py:0
msgid "Cannot incorporate transport: this order has posted invoices."
msgstr "Impossibile incorporare il trasporto: l'ordine ha fatture registrate."

#. module: alimac_sale_transport
#. odoo-python
#: code:addons/alimac_sale_transport/models/sale_order_line.py:0
msgid "Cannot modify order lines when transport is incorporated. Please use \"Uncorporate Transport\" button first."
msgstr "Impossibile modificare le righe d'ordine con il trasporto incorporato. Usare prima il pulsante \"Scorpora trasporto\"."

#. module: alimac_sale_transport
#. odoo-python
#: code:addons/alimac_sale_transport/models/sale_order.py:0
msgid "Cannot uncorporate transport: this order has draft invoices. Delete or cancel them first."
msgstr "Impossibile scorporare il trasporto: l'ordine ha fatture in bozza. Eliminarle o annullarle prima."

#. module: alimac_sale_transport
#. odoo-python
#: code:addons/alimac_sale_transport/models/sale_order.py:0
msgid "Cannot uncorporate transport: this order has posted invoices."
msgstr "Impossibile scorporare il trasporto: l'ordine ha fatture registrate."

