<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hide incorporated transport lines from sale order report (quotation/order confirmation) -->
    <template id="report_saleorder_document_inherit_transport" inherit_id="sale.report_saleorder_document">
        <!-- Filter out incorporated transport lines from customer view -->
        <xpath expr="//t[@t-foreach='doc.order_line']" position="replace">
            <t t-set="lines_to_display" t-value="doc.order_line.filtered(lambda l: not (l.product_id.is_transport and l.order_id.transport_incorporated and l.transport_reference_amount > 0 and l.price_unit == 0))"/>
            <t t-foreach="lines_to_display" t-as="line">
                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
                <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                    <t t-if="not line.display_type">
                        <td class="text-end">
                            <span t-field="line.product_uom_qty"/>
                            <span t-field="line.product_uom"/>
                        </td>
                        <td>
                            <span t-field="line.name"/>
                        </td>
                        <td class="text-end">
                            <span t-field="line.price_unit"/>
                        </td>
                        <td t-if="display_discount" class="text-end">
                            <span t-field="line.discount"/>
                        </td>
                        <td class="text-end">
                            <span t-field="line.tax_id" widget="many2many_tags"/>
                        </td>
                        <td class="text-end">
                            <span t-field="line.price_subtotal" widget="monetary" t-options='{"display_currency": doc.pricelist_id.currency_id}'/>
                        </td>
                    </t>
                    <t t-if="line.display_type == 'line_section'">
                        <td colspan="99">
                            <span t-field="line.name"/>
                        </td>
                        <t t-set="current_section" t-value="line"/>
                        <t t-set="current_subtotal" t-value="0"/>
                    </t>
                    <t t-if="line.display_type == 'line_note'">
                        <td colspan="99">
                            <span t-field="line.name"/>
                        </td>
                    </t>
                </tr>
                <t t-if="current_section and (line_last or doc.order_line[line_index+1].display_type == 'line_section')">
                    <tr class="is-subtotal text-end">
                        <td colspan="99">
                            <strong>Subtotal: </strong>
                            <span t-esc="current_subtotal" t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                        </td>
                    </tr>
                </t>
            </t>
        </xpath>
    </template>

</odoo>
