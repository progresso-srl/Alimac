<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Show delivery_note_ids on stock.picking form -->
    <record id="stock_picking_form_view_inherit_delivery_note" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.delivery.note</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="delivery_note_ids" widget="many2many_tags" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
