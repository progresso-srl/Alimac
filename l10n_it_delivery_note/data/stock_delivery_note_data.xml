<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Sequence for DDT numbering -->
    <record id="seq_stock_delivery_note" model="ir.sequence">
        <field name="name">Delivery Note (DDT)</field>
        <field name="code">stock.delivery.note</field>
        <field name="prefix">DDT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Transport Conditions -->
    <record id="transport_condition_PF" model="stock.picking.transport.condition">
        <field name="name">Porto franco</field>
        <field name="sequence">10</field>
    </record>

    <record id="transport_condition_PA" model="stock.picking.transport.condition">
        <field name="name">Porto assegnato</field>
        <field name="sequence">20</field>
    </record>

    <record id="transport_condition_PAF" model="stock.picking.transport.condition">
        <field name="name">Con addebito in fattura</field>
        <field name="sequence">30</field>
    </record>

</odoo>
